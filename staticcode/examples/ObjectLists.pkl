/// An example that shows the rendering of lists whose elements are objects.
module ObjectLists

import "../StaticCode.pkl"

people: List<Person> =
  List(
    new Person {
      name = "Alice"
      age = 25
    },
    new Person {
      name = "Bob"
      age = 30
    },
  )

teams: List<Team> =
  List(
    new Team {
      name = "Engineering"
      lead = new Person {
        name = "Carol"
        age = 35
      }
      members = new {
        new {
          name = "Dave"
          age = 28
        }
      }
    },
    new Team {
      name = "Design"
      members = new {}
    },
  )

noPeople: List<Person> = List()

nullablePeople: List<Person>? = null

local class Person {
  name: String
  age: Int
}

local class Team {
  name: String
  lead: Person?
  members: Listing<Person>
}

output {
  renderer = new StaticCode.Renderer {
    language = "Swift"
    objectName = "ObjectLists"
  }
}
