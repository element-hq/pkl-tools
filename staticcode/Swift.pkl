module io.element.staticcode.Swift

import "StaticCode.pkl"

/// An object being reflected for rendering.
///
/// This is used to represent the following:
/// - The top-level Module being rendered.
/// - A member of another object (when the type isn't a built-in type) either with a value or as `null`.
class ReflectedObject extends StaticCode.ReflectedType {
  /// The instance's name.
  name: String
  /// The type of this object.
  typeName: String
  /// Whether or not this object is allowed to be null.
  nullable: Boolean
  /// The object's isolation.
  isolation: StaticCode.Isolation?
  /// All of the object's properties.
  properties: List<StaticCode.ReflectedType>

  /// If the object has no value (because it is purely a type definition).
  fixed isNull: Boolean = properties.first.getClass() == ReflectedPropertyDefinition // Don't use `is` because of inheritance.

  /// Renders the object as a top level enum containing static properties and and custom type definitions.
  function render(indentLevel: Int): String =
    """
    \(indent(indentLevel))\(typeAnnotation)enum \(name.capitalize()) {
    \(properties
      .map((property) ->
        if (property is ReflectedObject)
          "\(indent(indentLevel + 1))static let \(property.name): \(property.renderedTypeHint) = \(property.renderValue(indentLevel + 1))"
        else
          "\(property.render(indentLevel + 1))"
      )
      .join("\n"))
    \(typeDefinitions.map((property) -> property.renderDefinition(indentLevel + 1)).join("\n"))
    \(indent(indentLevel))}
    """

  /// Renders the object's value for assignment (i.e. it's initialiser).
  function renderValue(indentLevel: Int): String =
    if (isNull)
      "nil"
    else
      """
      \(renderedType)(
      \(properties
        .map((property) ->
          "\(indent(indentLevel + 1))\(property.name): \(property.renderValue(indentLevel + 1))"
        )
        .join(",\n"))
      \(indent(indentLevel)))
      """

  /// Renders the object's definition without any values.
  function renderDefinition(indentLevel: Int): String =
    """
    \(indent(indentLevel))\(typeAnnotation)struct \(renderedType) {
    \(properties
      .map((property) ->
        if (property is ReflectedObject)
          "\(indent(indentLevel + 1))let \(property.name): \(property.renderedTypeHint)"
        else
          "\(indent(indentLevel + 1))let \(property.name): \(property.renderedType)"
      )
      .join("\n"))
    \(indent(indentLevel))}
    """

  fixed renderedType = typeName.capitalize()
  fixed renderedTypeHint: String = if (nullable) "\(renderedType)?" else renderedType

  hidden fixed typeDefinitions: List<ReflectedObject> =
    properties
      .flatMap((property) ->
        if (property is ReflectedObject)
          List(property) + property.typeDefinitions
        else if (property is ReflectedPropertyDefinition)
          property.typeArguments.flatMap((argument) ->
            if (argument is ReflectedObject)
              List(argument) + argument.typeDefinitions
            else
              List()
          )
        else
          List()
      )
      .toMap((property) -> property.typeName, (property) -> property)
      .values // Remove duplicates based on typeName.

  hidden fixed typeAnnotation: String =
    if (isolation != null)
      isolation + " "
    else
      ""
}

/// An object's property without an accompanying value.
///
/// This is used for null objects where we just need to render a type definition.
open class ReflectedPropertyDefinition extends StaticCode.ReflectedType {
  name: String
  type: String
  typeArguments: List<StaticCode.ReflectedType>
  nullable: Boolean

  function render(indentLevel: Int): String =
    "\(indent(indentLevel))static let \(name): \(renderedType)"

  fixed renderedType: String =
    let (swiftType = typeMap.getOrNull(type) ?? type)
    let (
      finalType =
        if (swiftType == "Array")
          "Array<\(typeArguments.getOrNull(0)?.renderedType ?? "Any")>"
        else
          swiftType
    )
      if (nullable) "\(finalType)?" else finalType

  hidden typeMap: Mapping<String, String> = new {
    ["Int"] = "Int"
    ["Float"] = "Double"
    ["Boolean"] = "Bool"
    ["String"] = "String"
    ["List"] = "Array"
    ["Listing"] = "Array"
  }
}

/// An object's property along with the value of this property.
class ReflectedProperty extends ReflectedPropertyDefinition {
  /// The property's value (raw or reflected as required).
  value: Any

  function render(indentLevel: Int): String =
    "\(indent(indentLevel))static let \(name): \(renderedType) = \(renderValue(indentLevel))"

  /// Renders the property's value, indented relative to the given level.
  function renderValue(indentLevel: Int): String =
    if (value is List)
      renderList(indentLevel)
    else
      renderedValue

  fixed renderedValue: String =
    if (value == null)
      "nil"
    else if (value is Number || value is Boolean)
      "\(value)"
    else if (value is String)
      renderString(value)
    else
      throw("Unsupported value type (\(value.getClass())) encountered when rendering \(name)")

  /// Renders the values as a list, inline unless one of them spans multiple lines.
  local function renderList(indentLevel: Int): String =
    let (listValues = value as List<StaticCode.ReflectedType>)
    let (renderedValues = listValues.map((listValue) -> listValue.renderValue(indentLevel + 1)))
      if (renderedValues.every((rendered) -> !rendered.contains("\n")))
        "[\(renderedValues.join(", "))]"
      else
        """
        [
        \(renderedValues.map((rendered) -> "\(indent(indentLevel + 1))\(rendered)").join(",\n"))
        \(indent(indentLevel))]
        """

  local function renderString(value: String) =
    if (value.contains("\n"))
      (
        "\"\"\""
          + value
          + "\"\"\""
      )
    else
      "\"" + value + "\""
}
